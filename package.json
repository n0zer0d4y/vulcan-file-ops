    "@types/node": "^26",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfmake": "^0.3.3",
    "jest": "30.5.2",
    "shx": "^0.4.0",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
