version: v1.25.1
ignore:
  SNYK-JS-PDFJSDIST-18592344:
    - 'officeparser > pdfjs-dist':
        reason: >-
          Not reachable. PDF files are parsed with pdf-parse, never with
          officeparser (src/utils/document-parser.ts routes .pdf away from
          officeparser), and this XSS requires rendering in a browser context.
          Remove once officeparser is upgraded past pdfjs-dist 6.2.108.
        expires: 2027-01-04T00:00:00.000Z
        created: 2026-10-04T00:00:00.000Z
patch: {}
